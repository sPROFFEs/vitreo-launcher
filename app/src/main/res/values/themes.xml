<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Vitreo" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowBackground">#101B2B</item>
    <item name="android:windowSplashScreenBackground">#101B2B</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_vitreo</item>
  </style>
  <color name="icon_background">#101B2B</color>
</resources>
